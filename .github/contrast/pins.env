# What a Contrast run on main uses. A change of this file is what starts a run on main.
# BOBCTL_TAG names a released internal build of bobctl (entlein/bob prerelease internal-<sha>), BOBCTL_SHA256 its checksum.
# Releasing bobctl and moving this pin are two separate actions. bobctl is never built in a job: a hand-started run names another released build.
PKG_REF=b97607edfd3341e13944972e45cd88f2246de894
BOBCTL_TAG=internal-b97607e
BOBCTL_SHA256=5d8ce963de4879906aa61c819c45bea81e346fc17d4bb645a0117009e4b7bf62
CHART_VER=1.41.0-duckling201
ALL_APPS="php2shell php2shell-wordpress nginx2root postgres mariadb redis wordpress nginx envoy zot cert-manager keycloak kafka argo-workflows otel-collector falco-old+falco-new flux-source+flux-kustomize+flux-helm+flux-notification+flux-image-reflector+flux-image-automation mongodb memcached cnpg strimzi tomcat verdaccio registry adminer pypiserver envoy-gateway prometheus+alertmanager+prom-operator"
