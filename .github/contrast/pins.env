# What a Contrast run on main uses. A change of this file is what starts a run on main.
# BOBCTL_TAG names a released internal build of bobctl (entlein/bob prerelease internal-<sha>), BOBCTL_SHA256 its checksum.
# Releasing bobctl and moving this pin are two separate actions; only a hand-started run may pass bobctl_tag=build to try a revision.
PKG_REF=74f13862fa33e8388345de539b50ec63621c844d
BOBCTL_TAG=internal-74f1386
BOBCTL_SHA256=8f387815a78c400d79c703c33edeb83d7734bac9a503a814db138765112664c5
CHART_VER=1.41.0-duckling201
ALL_APPS="php2shell php2shell-wordpress nginx2root postgres mariadb redis wordpress nginx envoy zot cert-manager keycloak kafka argo-workflows otel-collector falco-old+falco-new flux-source+flux-kustomize+flux-helm+flux-notification+flux-image-reflector+flux-image-automation mongodb memcached cnpg strimzi tomcat verdaccio registry adminer pypiserver envoy-gateway"
