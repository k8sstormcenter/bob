# What a Contrast run on main uses. A change of this file is what starts a run on main.
# BOBCTL_TAG names a released internal build of bobctl (entlein/bob prerelease internal-<sha>), BOBCTL_SHA256 its checksum.
# Releasing bobctl and moving this pin are two separate actions. bobctl is never built in a job: a hand-started run names another released build.
PKG_REF=5f5dea658a59abe4c9fe54a31f596fb4ff85a009
BOBCTL_TAG=internal-5f5dea6
BOBCTL_SHA256=337d523382319fdc743ab87445605621569f50e1e12bdd3c1ea8779abc2bc480
CHART_VER=1.41.0-duckling213
ALL_APPS="php2shell php2shell-wordpress nginx2root postgres mariadb redis wordpress nginx envoy zot cert-manager keycloak kafka argo-workflows otel-collector falco-old+falco-new flux-source+flux-kustomize+flux-helm+flux-notification+flux-image-reflector+flux-image-automation mongodb memcached cnpg strimzi tomcat verdaccio registry adminer pypiserver envoy-gateway prometheus+alertmanager+prom-operator kyverno+kyverno-background+kyverno-cleanup+kyverno-reports react2shell langflow geoserver"
