# What a Contrast run on main uses. A change of this file is what starts a run on main.
# BOBCTL_TAG names a released internal build of bobctl (entlein/bob prerelease internal-<sha>), BOBCTL_SHA256 its checksum.
# Releasing bobctl and moving this pin are two separate actions. bobctl is never built in a job: a hand-started run names another released build.
PKG_REF=e8b39b653fdbc5cdcddbee150572f15a81e018ba
BOBCTL_TAG=internal-e8b39b6
BOBCTL_SHA256=2b48bbb447c662bd1ed27e564df21a2d149cad6c6b1afb2fc96a9a2a0efbbfa1
CHART_VER=1.41.0-duckling201
ALL_APPS="php2shell php2shell-wordpress nginx2root postgres mariadb redis wordpress nginx envoy zot cert-manager keycloak kafka argo-workflows otel-collector falco-old+falco-new flux-source+flux-kustomize+flux-helm+flux-notification+flux-image-reflector+flux-image-automation mongodb memcached cnpg strimzi tomcat verdaccio registry adminer pypiserver envoy-gateway prometheus+alertmanager+prom-operator kyverno+kyverno-background+kyverno-cleanup+kyverno-reports"
