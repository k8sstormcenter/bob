# What a Contrast run on main uses. A change of this file is what starts a run on main.
# BOBCTL_TAG names a released internal build of bobctl (entlein/bob prerelease internal-<sha>), BOBCTL_SHA256 its checksum.
# Releasing bobctl and moving this pin are two separate actions. bobctl is never built in a job: a hand-started run names another released build.
PKG_REF=5ad01a56fce8ca4724fb11316fd2acdfede07a19
BOBCTL_TAG=internal-5ad01a5
BOBCTL_SHA256=89db57e735939b9e2995e5b676acc039dcccd14d877bd93349193d82b1c51baa
CHART_VER=1.41.0-duckling213
ALL_APPS="php2shell php2shell-wordpress nginx2root postgres mariadb redis wordpress nginx envoy zot cert-manager keycloak kafka argo-workflows otel-collector falco-old+falco-new flux-source+flux-kustomize+flux-helm+flux-notification+flux-image-reflector+flux-image-automation mongodb memcached cnpg strimzi tomcat verdaccio registry adminer pypiserver envoy-gateway prometheus+alertmanager+prom-operator kyverno+kyverno-background+kyverno-cleanup+kyverno-reports react2shell"
